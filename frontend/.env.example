# Copy to .env — never commit real values.
# Local backend running against staging (see backend/.env.staging).
VITE_API_URL=http://localhost:8000/v1

# Supabase project (public values only — publishable key, never the secret).
VITE_SUPABASE_URL=https://PASTE_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_sb_publishable_KEY

# Cloudflare Turnstile site key. Empty = documented dev bypass (never in prod).
VITE_TURNSTILE_SITE_KEY=
