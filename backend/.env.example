# Copy to .env — never commit real secrets (see R4: secrets must not live in docs/seeds)
APP_NAME=KJAC API
APP_VERSION=0.1.0
DEBUG=false

# Async SQLAlchemy URL (Supabase Postgres, STARTTLS). Example:
# postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kjac_db

# Supabase Auth (sole auth source — no local password_hash per CONTRACTS.md C1)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Email-code 2FA (per CONTRACTS.md C2)
TWO_FA_CODE_TTL_MINUTES=10
TWO_FA_RESEND_COOLDOWN_SECONDS=60
TWO_FA_MAX_ATTEMPTS=5
TWO_FA_TICKET_TTL_HOURS=12

# Signs admin 2FA tickets. REQUIRED in production — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# Outbound SMTP (2FA codes, receipts). Local dev: python -m aiosmtpd -n -l 127.0.0.1:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KJAC <noreply@kjac-system.com>
SMTP_USE_TLS=false

# Rate limits (per CONTRACTS.md)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BOOKING_RATE_LIMIT_COUNT=3
BOOKING_RATE_LIMIT_MINUTES=30

# Web booking CAPTCHA. Empty = dev bypass (accept + warn, never in prod).
TURNSTILE_SECRET=

# Uploads: local dir (dev) or supabase storage (prod, needs service key).
STORAGE_BACKEND=local
STORAGE_DIR=storage
SUPABASE_SERVICE_KEY=
MAX_UPLOAD_MB=3

# PSGC address proxy (upstream + TTL cache + DB upsert).
PSGC_BASE_URL=https://psgc.cloud/api
PSGC_CACHE_TTL_SECONDS=86400

# Public web base URL for emailed links (technician invites).
PUBLIC_APP_URL=http://localhost:5173

# CORS (React 19 web dev + Flutter)
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
