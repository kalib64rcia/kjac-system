# KJAC staging environment — copy to .env.staging and paste real values.
# NEVER commit .env.staging (gitignored). Sources in Supabase dashboard:
#   URL + keys: Settings → API | DB password: Settings → Database
APP_NAME=KJAC API
APP_VERSION=0.1.0
DEBUG=false

# Migrations (alembic): use the DIRECT connection (port 5432).
DATABASE_URL=postgresql+asyncpg://postgres:PASTE_DB_PASSWORD@db.PASTE_PROJECT_REF.supabase.co:5432/postgres?ssl=require
# App runtime: preferably the pooler, Transaction mode, port 6543:
# DATABASE_URL=postgresql+asyncpg://postgres.PASTE_PROJECT_REF:PASTE_DB_PASSWORD@aws-0-PASTE_REGION.pooler.supabase.com:6543/postgres?ssl=require

# Supabase (new key names; Settings → API).
SUPABASE_URL=https://PASTE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=PASTE_sb_publishable_KEY
SUPABASE_SECRET_KEY=PASTE_sb_secret_KEY
SUPABASE_JWKS_URL=https://PASTE_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Backend ticket signing — generate FRESH for staging, never reuse dev value:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=PASTE_GENERATED_64_HEX_CHARS

# Outbound SMTP (2FA codes, invites, lifecycle mail).
SMTP_HOST=PASTE_SMTP_HOST
SMTP_PORT=587
SMTP_USER=PASTE_SMTP_USER
SMTP_PASSWORD=PASTE_SMTP_PASSWORD
SMTP_FROM=KJAC <PASTE_SENDER_ADDRESS>
SMTP_USE_TLS=true

# Email-code 2FA + rate limits (safe defaults).
TWO_FA_CODE_TTL_MINUTES=10
TWO_FA_RESEND_COOLDOWN_SECONDS=60
TWO_FA_MAX_ATTEMPTS=5
TWO_FA_TICKET_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BOOKING_RATE_LIMIT_COUNT=3
BOOKING_RATE_LIMIT_MINUTES=30

# Cloudflare Turnstile secret. Empty = dev bypass (accept + warn, never in prod).
TURNSTILE_SECRET=

# Receipts on Supabase Storage (create a PRIVATE bucket named "receipts" first).
STORAGE_BACKEND=supabase
STORAGE_DIR=storage
MAX_UPLOAD_MB=3

# PSGC address proxy (upstream + TTL cache + DB upsert).
PSGC_BASE_URL=https://psgc.cloud/api
PSGC_CACHE_TTL_SECONDS=86400

# Public web base URL for emailed links (technician invites).
PUBLIC_APP_URL=https://PASTE_STAGING_FRONTEND_URL

# CORS: staging frontend origin(s) only.
ALLOWED_ORIGINS=["https://PASTE_STAGING_FRONTEND_URL"]
